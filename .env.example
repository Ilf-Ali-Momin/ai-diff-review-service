# Copy to .env and fill in. .env is gitignored and must never be committed.

# Required. The bearer token the client calls this service with.
# Generate one with: openssl rand -hex 32
AUTH_TOKEN=

# Optional. Defaults to 3000. Usually injected by the platform.
PORT=

# The llm provider. Any OpenAI compatible chat completions endpoint works
# unchanged: Groq, OpenRouter, Together, a self hosted Ollama.
#
# The service starts and serves without these. Only a job asking for the llm
# provider fails, with a clear message, because the mock provider is what is
# scored. Leaving them blank is a valid configuration, not a broken one.
#
# Example base URL: https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional. Milliseconds before a model request is abandoned. Defaults to 20000.
# A request that times out is retried once, then the job fails.
LLM_TIMEOUT_MS=

# Benchmark only, and only for bench:push. Salts the opaque slug each case is
# published under in the cases repository. Without it the slug is a hash of a
# case id committed to this repository, so anyone holding the source could
# recompute the mapping and read the answer for a case they were reviewing.
# Any secret of your own works. Keep it the same for the life of a published
# set, or a rerun opens a second pull request per case instead of updating the
# first. Generate one with: openssl rand -hex 16
BENCH_SLUG_SALT=

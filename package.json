{
  "name": "ai-diff-review-service",
  "version": "1.0.0",
  "private": true,
  "description": "AI diff review service: submit a unified diff, receive structured review findings",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe": "vitest run --config vitest.probe.config.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
